#[test] 
fn nil_is_nil {
  assert.is_of_type(nil, Nil);
  assert.equal(nil, nil);
}

#[test] 
fn number_is_number {
  assert.is_of_type(21.37, Number);
  assert.equal(21.37, 21.37);
}

#[test] 
fn string_is_string {
  assert.is_of_type("jp2gmd", String);
  assert.equal("jp2gmd", "jp2gmd");
}

#[test]
fn false_is_false {
  assert.is_of_type(false, Boolean);
  assert.equal(false, false);
}

#[test]
fn true_is_true {
  assert.is_of_type(true, Boolean);
  assert.equal(true, true);
}

#[test]
fn nan_is_in_fact_a_number {
  assert.is_of_type(NaN, Number);
}

#[test]
fn infinity_is_a_number_too {
  assert.is_of_type(Infinity, Number);
}

#[test] 
fn can_invert_infinity {
  assert.not_equal(Infinity, -Infinity);
}

#[test]
fn interpolated_string_locals_only_before_and_after_present {
  val a = 21.37;
  val b = "12345";
  
  assert.equal(
    "nyaa  ($a), $b, uwu", 
    'nyaa  (21.37), 12345, uwu'
  ); 
}

#[test]
fn interpolated_string_locals_only_after_present {
  val a = 21.37;
  val b = "12345";
  
  assert.equal(
    "$a, $b, uwu", 
    '21.37, 12345, uwu'
  ); 
}

#[test]
fn interpolated_string_locals_only {
  val a = 21.37;
  val b = "12345";
  
  assert.equal(
    "$a, $b", 
    '21.37, 12345'
  ); 
}

#[test]
fn interpolated_string_locals_and_globals {
  val a = 21.37;
  val b = "12345";
  jp2 = "gmd";
  
  assert.equal(
    "$a, $b, $jp2", 
    '21.37, 12345, gmd'
  ); 
}

#[test]
fn interpolated_string_symbol_prompt_only {
  val b = "12345";
  
  assert.equal(
    "$, $b", 
    '$, 12345'
  ); 
}

#[test]
fn number_with_exponent {
  val a = 1e+3;
  val b = 2E2;
  val c = 3E-2;
  
  assert.equal(a, 1000);
  assert.equal(b, 200);
  assert.equal(c, 0.03);
}

#[test]
fn interpolated_string_escaped_dollar {
  val a = "hello";
  assert.equal("\$a = $a", '$a = hello');
  assert.equal("\$a", '$a');
  assert.equal("cost: \$100", 'cost: $100');
}

#[test]
fn type_fn_alias {
  assert.equal(typeof(fn() {}), Fn);
  assert(fn() {} is Fn);
}

#[test]
fn interpolated_string_expressions() {
  val x = 10;
  val y = 20;
  assert.equal("sum: ${x + y}", 'sum: 30');
  assert.equal("${x} + ${y} = ${x + y}", '10 + 20 = 30');
  assert.equal("${1 + 2 * 3}", '7');
}

#[test]
fn interpolated_string_expression_conditional() {
  val active = true;
  assert.equal("status: ${active ? 'online' : 'offline'}", 'status: online');
  assert.equal("status: ${!active ? 'online' : 'offline'}", 'status: offline');
  assert.equal("nested quotes: ${active ? "yes" : "no"}", 'nested quotes: yes');
}

#[test]
fn interpolated_string_expression_members_and_calls() {
  val t = { name: "EVIL", ver: 2 };
  val arr = array { 100, 200, 300 };
  loc fn square(n) -> n * n;
  
  assert.equal("lang: ${t.name} v${t.ver}", 'lang: EVIL v2');
  assert.equal("item: ${arr[1]}", 'item: 200');
  assert.equal("calc: ${square(5)}", 'calc: 25');
  assert.equal("table expr: ${ { num: 42 }.num }", 'table expr: 42');
}

#[test]
fn interpolated_string_expression_nested_interpolation() {
  val a = 5;
  assert.equal("outer: ${"inner: ${a * 2}"}", 'outer: inner: 10');
}

#[test]
fn interpolated_string_expression_escaped() {
  val a = 1;
  val b = 2;
  assert.equal("calc: \${a + b} = ${a + b}", 'calc: ${a + b} = 3');
}