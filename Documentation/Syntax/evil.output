Grammar

    0 $accept: program $end

    1 program: statement_list_opt

    2 statement_list_opt: ε
    3                   | statement_list

    4 statement_list: statement
    5               | statement_list statement

    6 statement: fn_statement
    7          | if_statement
    8          | for_statement
    9          | while_statement
   10          | do_while_statement
   11          | each_statement
   12          | block_statement
   13          | val_statement
   14          | try_statement
   15          | retry_statement
   16          | throw_statement
   17          | ret_statement
   18          | skip_statement
   19          | break_statement
   20          | expression_statement

   21 expression_statement: assignment_expression ';'

   22 block_statement: '{' statement_list_opt '}'

   23 retry_statement: "retry" ';'

   24 throw_statement: "throw" assignment_expression ';'

   25 ret_statement: "ret" ';'
   26              | "ret" assignment_expression ';'

   27 skip_statement: "skip" ';'

   28 break_statement: "break" ';'

   29 while_statement: "while" '(' assignment_expression ')' statement

   30 do_while_statement: "do" statement "while" '(' assignment_expression ')' ';'

   31 val_statement: "val" val_declarator_seq ';'
   32              | "rw" "val" val_declarator_seq ';'

   33 val_declarator_seq: val_declarator
   34                   | val_declarator_seq ',' val_declarator

   35 val_declarator: "identifier"
   36               | "identifier" '=' assignment_expression
   37               | array_pattern "<-" assignment_expression
   38               | table_pattern "<-" assignment_expression

   39 array_pattern: '[' pattern_binding_seq ']'

   40 pattern_binding_seq: pattern_binding
   41                    | pattern_binding_seq ',' pattern_binding
   42                    | pattern_binding_seq ','

   43 pattern_binding: "identifier"
   44                | "rw" "identifier"

   45 table_pattern: '{' table_pattern_field_seq '}'

   46 table_pattern_field_seq: table_pattern_field
   47                        | table_pattern_field_seq ',' table_pattern_field
   48                        | table_pattern_field_seq ','

   49 table_pattern_field: "identifier"
   50                    | "identifier" ':' pattern_binding
   51                    | "rw" "identifier"
   52                    | "rw" "identifier" ':' pattern_binding
   53                    | '[' "plain_string" ']' ':' pattern_binding
   54                    | "rw" '[' "plain_string" ']' ':' pattern_binding

   55 each_statement: "each" '(' "rw" "val" "identifier" ':' assignment_expression ')' statement
   56               | "each" '(' "rw" "val" "identifier" ',' "identifier" ':' assignment_expression ')' statement

   57 for_statement: "for" '(' for_init_list_opt ';' assignment_expression ';' for_step_list_opt ')' statement

   58 for_init_list_opt: ε
   59                  | for_init_list

   60 for_init_list: for_init_item
   61              | for_init_list ',' for_init_item

   62 for_init_item: "rw" "val" val_declarator_seq
   63              | assignment_expression

   64 for_step_list_opt: ε
   65                  | for_step_list

   66 for_step_list: assignment_expression
   67              | for_step_list ',' assignment_expression

   68 if_statement: "if" '(' assignment_expression ')' if_branch elif_list else_opt

   69 elif_list: ε
   70          | elif_list "elif" '(' assignment_expression ')' if_branch

   71 else_opt: ε
   72         | "else" if_branch

   73 if_branch: statement
   74          | "->" assignment_expression ';'

   75 try_statement: "try" statement catch_clause_opt

   76 catch_clause_opt: ε
   77                 | "catch" block_statement
   78                 | "catch" '(' "identifier" ')' block_statement

   79 fn_statement: attribute_list_seq fn_head fn_body
   80             | fn_head fn_body

   81 attribute_list_seq: attribute_list
   82                   | attribute_list_seq attribute_list

   83 attribute_list: "#[" attribute_seq ']'

   84 attribute_seq: attribute_item
   85              | attribute_seq ';' attribute_item

   86 attribute_item: "identifier"
   87               | "identifier" '(' ')'
   88               | "identifier" '(' attribute_arg_list ')'

   89 attribute_arg_list: attribute_arg
   90                   | attribute_arg_list ',' attribute_arg

   91 attribute_arg: assignment_expression

   92 fn_head: fn_modifier fn_target parameter_list_opt

   93 fn_modifier: "fn"
   94            | "loc" "fn"

   95 fn_target: fn_name_chain
   96          | fn_name_chain "::" "identifier"
   97          | "self" "::" "identifier"

   98 fn_name_chain: "identifier"
   99              | fn_name_chain '.' "identifier"

  100 parameter_list_opt: ε
  101                   | '(' parameter_list ')'

  102 parameter_list: ε
  103               | "self"
  104               | "self" ',' param_seq
  105               | param_seq

  106 param_seq: param_item
  107          | param_seq ',' param_item

  108 param_item: "identifier"
  109           | "identifier" '=' assignment_expression
  110           | "rw" "identifier"
  111           | "rw" "identifier" '=' assignment_expression

  112 fn_body: block_statement
  113        | "->" assignment_expression ';'

  114 assignment_expression: conditional_expression
  115                      | unary_expression assignment_operator assignment_expression
  116                      | fn_arrow_expression

  117 fn_arrow_expression: "fn" parameter_list_opt "->" assignment_expression

  118 assignment_operator: '='
  119                    | "+="
  120                    | "-="
  121                    | "*="
  122                    | "/="
  123                    | "%="
  124                    | "&="
  125                    | "|="
  126                    | "^="
  127                    | ">>="
  128                    | "<<="
  129                    | "??="

  130 conditional_expression: coalescing_expression
  131                       | coalescing_expression '?' assignment_expression ':' conditional_expression

  132 coalescing_expression: logical_or_expression
  133                      | logical_or_expression "??" coalescing_rhs

  134 coalescing_rhs: assignment_expression
  135               | "throw" assignment_expression

  136 logical_or_expression: logical_and_expression
  137                      | logical_or_expression "||" logical_and_expression

  138 logical_and_expression: inclusive_or_expression
  139                       | logical_and_expression "&&" inclusive_or_expression

  140 inclusive_or_expression: exclusive_or_expression
  141                        | inclusive_or_expression '|' exclusive_or_expression

  142 exclusive_or_expression: and_expression
  143                        | exclusive_or_expression '^' and_expression

  144 and_expression: equality_expression
  145               | and_expression '&' equality_expression

  146 equality_expression: relational_expression
  147                    | equality_expression "==" relational_expression
  148                    | equality_expression "!=" relational_expression
  149                    | equality_expression "<==>" relational_expression
  150                    | equality_expression "<!=>" relational_expression

  151 relational_expression: shift_expression
  152                      | relational_expression '<' shift_expression
  153                      | relational_expression "<-" left_arrow_shift_expression
  154                      | relational_expression '>' shift_expression
  155                      | relational_expression "<=" shift_expression
  156                      | relational_expression ">=" shift_expression
  157                      | relational_expression "in" shift_expression
  158                      | relational_expression "!in" shift_expression
  159                      | relational_expression "is" type_code is_native_opt
  160                      | relational_expression "!is" type_code is_native_opt

  161 left_arrow_shift_expression: left_arrow_additive_expression
  162                            | left_arrow_shift_expression "<<" additive_expression
  163                            | left_arrow_shift_expression ">>" additive_expression

  164 left_arrow_additive_expression: left_arrow_multiplicative_expression
  165                               | left_arrow_additive_expression '+' multiplicative_expression
  166                               | left_arrow_additive_expression '-' multiplicative_expression

  167 left_arrow_multiplicative_expression: left_arrow_pattern_expression
  168                                     | left_arrow_multiplicative_expression '*' pattern_expression
  169                                     | left_arrow_multiplicative_expression '/' pattern_expression
  170                                     | left_arrow_multiplicative_expression '%' pattern_expression

  171 left_arrow_pattern_expression: '-' prefix_expression
  172                              | left_arrow_pattern_expression "with" table_expression

  173 is_native_opt: ε
  174              | string_literal

  175 type_code: "Nil"
  176          | "Number"
  177          | "String"
  178          | "Boolean"
  179          | "Table"
  180          | "Array"
  181          | "Fiber"
  182          | "Function"
  183          | "Error"
  184          | "Type"
  185          | "NativeFunction"
  186          | "NativeObject"

  187 shift_expression: additive_expression
  188                 | shift_expression "<<" additive_expression
  189                 | shift_expression ">>" additive_expression

  190 additive_expression: multiplicative_expression
  191                    | additive_expression '+' multiplicative_expression
  192                    | additive_expression '-' multiplicative_expression

  193 multiplicative_expression: pattern_expression
  194                          | multiplicative_expression '*' pattern_expression
  195                          | multiplicative_expression '/' pattern_expression
  196                          | multiplicative_expression '%' pattern_expression

  197 pattern_expression: by_expression
  198                   | with_expression

  199 by_expression: "by" assignment_expression '{' by_arm_seq comma_opt '}'

  200 by_arm_seq: by_arm
  201           | by_arm_seq ',' by_arm

  202 by_arm: assignment_expression "->" by_value
  203       | assignment_expression "=>" by_value
  204       | "else" ':' by_value

  205 by_value: assignment_expression
  206         | "throw" assignment_expression

  207 with_expression: prefix_expression
  208                | with_expression "with" table_expression

  209 prefix_expression: "++" unary_expression
  210                  | "--" unary_expression
  211                  | unary_expression

  212 unary_expression: postfix_expression
  213                 | '+' unary_expression
  214                 | '-' unary_expression
  215                 | '!' unary_expression
  216                 | '~' unary_expression
  217                 | '@' unary_expression
  218                 | '#' unary_expression
  219                 | '$' unary_expression

  220 postfix_expression: primary_expression
  221                   | postfix_expression '(' argument_list_opt ')'
  222                   | postfix_expression "?(" argument_list_opt ')'
  223                   | postfix_expression '[' index_argument ']'
  224                   | postfix_expression '.' "identifier"
  225                   | postfix_expression "?." "identifier"
  226                   | postfix_expression "?[" index_argument ']'
  227                   | postfix_expression ':' "identifier" '(' argument_list_opt ')'
  228                   | postfix_expression "?:" "identifier" '(' argument_list_opt ')'
  229                   | postfix_expression "++"
  230                   | postfix_expression "--"
  231                   | postfix_expression '!'

  232 index_argument: assignment_expression
  233               | '#' assignment_expression
  234               | range_bound ".." range_bound_opt
  235               | ".." range_bound_opt

  236 range_bound: assignment_expression
  237            | '#' assignment_expression

  238 range_bound_opt: ε
  239                | range_bound

  240 argument_list_opt: ε
  241                  | argument_list

  242 argument_list: arg_seq comma_opt

  243 arg_seq: arg_item
  244        | arg_seq ',' arg_item

  245 arg_item: assignment_expression
  246         | '*'

  247 primary_expression: '(' assignment_expression ')'
  248                   | table_expression
  249                   | array_expression
  250                   | error_expression
  251                   | "..."
  252                   | fn_block_expression
  253                   | "identifier"
  254                   | "self"
  255                   | typeof_expression
  256                   | yield_expression
  257                   | constant_expression

  258 table_expression: '{' table_entry_list_opt '}'

  259 table_entry_list_opt: ε
  260                     | table_entry_seq comma_opt

  261 table_entry_seq: table_entry
  262                | table_entry_seq ',' table_entry

  263 table_entry: assignment_expression
  264            | self_fn_expression
  265            | "identifier" ':' assignment_expression
  266            | "identifier" ':' self_fn_expression
  267            | assignment_expression "=>" assignment_expression
  268            | assignment_expression "=>" self_fn_expression
  269            | "...?" assignment_expression
  270            | "..." assignment_expression

  271 self_fn_expression: "self" "::" "fn" parameter_list_opt block_statement
  272                   | "self" "::" "fn" parameter_list_opt "->" assignment_expression

  273 array_expression: '[' array_element_list_opt ']'
  274                 | "array" '(' assignment_expression ')'
  275                 | "array" '(' assignment_expression ')' '{' array_element_list_opt '}'
  276                 | "array" '(' ')' '{' array_element_list_opt '}'
  277                 | "array" '{' array_element_list_opt '}'

  278 array_element_list_opt: ε
  279                       | array_element_seq comma_opt

  280 array_element_seq: assignment_expression
  281                  | array_element_seq ',' assignment_expression

  282 error_expression: "error" '(' string_literal ')'
  283                 | "error" '(' string_literal ')' table_expression
  284                 | "error" table_expression

  285 typeof_expression: "typeof" '(' assignment_expression ')'
  286                  | "typeof" '!' '(' assignment_expression ')'

  287 yield_expression: "yield" postfix_expression

  288 fn_block_expression: "fn" parameter_list_opt block_statement

  289 constant_expression: "number"
  290                    | "hex_integer"
  291                    | string_literal
  292                    | "true"
  293                    | "false"
  294                    | "nil"
  295                    | "NaN"
  296                    | "Infinity"
  297                    | type_code

  298 string_literal: "plain_string"
  299               | "interpolated_string"

  300 comma_opt: ε
  301          | ','


